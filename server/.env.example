# WIGO admin server — copy to server/.env for local runs. Never commit a real .env.
PORT=4000
NODE_ENV=development

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

CORS_ORIGINS=http://localhost:5173

# WhatsApp Business API (NotificationsPort). driver = fake | live
WHATSAPP_DRIVER=fake
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=

# N1CO payments (PaymentsPort). driver = fake | live
N1CO_DRIVER=fake
N1CO_BASE_URL=
N1CO_API_KEY=
