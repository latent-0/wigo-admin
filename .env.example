# WIGO Admin — root environment template.
# Copy to `.env` and fill locally. NEVER commit a real .env (see .gitignore).
# The app boots fully on the deterministic FAKE adapters with no real credentials,
# which is how staging demos and CI run. Flip the *_DRIVER vars to "live" only once
# the WhatsApp Business API and N1CO sandbox credentials have landed.

# ---- Server ----
PORT=4000
NODE_ENV=development

# Auth. Generate a long random string for production; the default below is dev-only.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

# CORS allowlist (comma separated). The web dev server origin by default.
CORS_ORIGINS=http://localhost:5173

# ---- Integrations: WhatsApp Business API (NotificationsPort) ----
# driver = fake | live
WHATSAPP_DRIVER=fake
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=

# ---- Integrations: N1CO payments (PaymentsPort) ----
# driver = fake | live
N1CO_DRIVER=fake
N1CO_BASE_URL=
N1CO_API_KEY=
